# Copy this file to .env on the machine that runs the bot.
# Fill in values locally. Never commit .env. Values below are intentionally blank.
# Live orders also require live.enabled = true in config.toml.
# Leave POLYBTC_LIVE_CONFIRM blank to stay in paper mode.

POLYBTC_LIVE_CONFIRM=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Optional. Only for Polymarket gasless relayer or builder wallet deployment.
# Not required to place CLOB orders for an existing account wallet.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Set to 1 to latch the kill switch for this process environment.
POLYBTC_KILL=
